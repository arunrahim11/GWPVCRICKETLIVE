rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /tournaments/gwpv-2026 {
      // Scores, squads, fixtures and phone numbers are intentionally public.
      allow read: if true;

      // Replace the placeholder with the UID of the one organizer account.
      allow create, update, delete: if request.auth != null
        && request.auth.uid == "PASTE_ORGANIZER_FIREBASE_UID";
    }

    // Everything else is private by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
