rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /tournaments/gwpv-2026 {
      // Published tournament information is public and read-only for visitors.
      allow read: if true;

      // Replace the placeholder with the UID of the one organizer account.
      allow create, update, delete: if request.auth != null
        && request.auth.uid == "GHIfihuSOTTuUTriH6Jcb12ijZh2";
    }

    match /tournamentPrivate/gwpv-2026 {
      // Organizer-only contact backup and legacy migration data.
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == "GHIfihuSOTTuUTriH6Jcb12ijZh2";
    }

    match /teamLogos/{teamId} {
      // Public team logos; only the organizer can upload or replace them.
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == "GHIfihuSOTTuUTriH6Jcb12ijZh2";
    }

    match /committeePhotos/{memberId} {
      // Public committee photos; only the organizer can upload or replace them.
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == "GHIfihuSOTTuUTriH6Jcb12ijZh2"
        && request.resource.data.sizeBytes is int
        && request.resource.data.sizeBytes <= 512000
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() <= 700000;
      allow delete: if request.auth != null
        && request.auth.uid == "GHIfihuSOTTuUTriH6Jcb12ijZh2";
    }

    // Everything else is private by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
